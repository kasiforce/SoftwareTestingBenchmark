# Use Ubuntu 22.04 as a stable base image with /bin/bash support
FROM --platform=linux/x86_64 ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG FAKE_DATE
ENV TZ=Etc/UTC
ENV FAKE_SYSTEM_DATE=${FAKE_DATE}

# Workaround for potential GPG/apt expiry issues
RUN echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99ignore-time

# System dependencies: git, wget, curl, locales, tzdata, build-essential, OpenJDK 8, Maven
RUN apt update && apt install -y \
    git \
    wget \
    curl \
    build-essential \
    openjdk-8-jdk \
    maven \
    locales \
    locales-all \
    tzdata \
    patch \
    && rm -rf /var/lib/apt/lists/*

# Set JAVA_HOME and prioritize it
ENV JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
ENV PATH=$JAVA_HOME/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Set UTF-8 locale
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Set workdir for the project
WORKDIR /testbed/

# Clone the target repository, checkout the exact commit
RUN git clone https://github.com/alibaba/fastjson.git /testbed && \
    cd /testbed && \
    git reset --hard c942c83 && \
    git remote remove origin && \
    chmod -R 777 /testbed

# Install all Maven dependencies (without running tests) and build project in local repository (for development mode)
RUN mvn install -DskipTests

# Ensure /bin/bash is the default shell for further scripts
SHELL ["/bin/bash", "-c"]

# Note: No virtualenv required for Java/Maven, as JAVA_HOME+Maven provide isolation.
# The project is now ready for test execution (via `mvn test` out-of-container).