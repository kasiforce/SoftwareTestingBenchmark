FROM --platform=linux/x86_64 ubuntu:22.04

# 设置非交互模式与时区
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# 安装基础工具（分步以便调试）
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    software-properties-common \
    curl && \
    rm -rf /var/lib/apt/lists/*

# 显式安装 gnupg（如后续需要）
RUN apt-get update && \
    apt-get install -y gnupg && \
    rm -rf /var/lib/apt/lists/*

# 更新仓库（使用默认源和密钥）
RUN apt-get update && rm -rf /var/lib/apt/lists/*

# 安装系统依赖（移除 maven）
RUN apt-get update && \
    apt-get install -y \
    git \
    wget \
    build-essential \
    openjdk-17-jdk \
    tzdata \
    locales-all && \
    rm -rf /var/lib/apt/lists/*

# 配置 Java 环境
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="$JAVA_HOME/bin:$PATH"

# 安装 Maven 3.9.6（手动下载）
ARG MAVEN_VERSION=3.9.6
RUN wget -q https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz -O /tmp/maven.tar.gz && \
    tar xzf /tmp/maven.tar.gz -C /opt && \
    ln -s /opt/apache-maven-${MAVEN_VERSION} /opt/maven && \
    rm /tmp/maven.tar.gz

# 设置 Maven 环境变量
ENV MAVEN_HOME=/opt/maven
ENV PATH="${MAVEN_HOME}/bin:${PATH}"

# 创建 Maven 配置目录
RUN mkdir -p ~/.m2

# 设置 Maven 优化参数
ENV MAVEN_OPTS="-Xmx2g -Xms256m"

# 设置工作目录
WORKDIR /testbed/

# 克隆仓库并检出指定提交
RUN git clone https://github.com/google/gson.git /testbed/ && \
    cd /testbed/ && \
    git reset --hard b3f4ca20087f9066de4c340522ff84e0558e1ad1 && \
    git remote remove origin

# 安装 Maven 依赖（跳过测试，但插件仍需兼容的 Maven 版本）
RUN mvn clean install -Dmaven.test.skip=true

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir openai

# 配置 Bash 环境
# 配置 Bash 环境
ENV MAVEN_ARGS="--show-version --batch-mode --no-transfer-progress"
RUN echo "JAVA_HOME=${JAVA_HOME}" >> /root/.bashrc
RUN echo "PATH=${PATH}" >> /root/.bashrc