FROM --platform=linux/x86_64 ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG FAKE_DATE
ENV TZ=Etc/UTC
ENV FAKE_SYSTEM_DATE=${FAKE_DATE}

# Avoid GPG issues with out-of-date Release files
RUN echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99ignore-time

# Ensure expected directories exist for Java alternatives and binfmts
RUN mkdir -p /usr/share/binfmts

# Install ONLY openjdk-8-jdk first, to avoid Java 11 jre-headless install errors
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openjdk-8-jdk \
        && rm -rf /var/lib/apt/lists/*

# Pin openjdk-8-jdk so nothing replaces it, and hold problematic Java 11 packages
RUN apt-mark hold openjdk-8-jdk openjdk-11-jre-headless default-jre-headless || true

# Now install remaining essential tools (split step to avoid auto-pulling Java 11 by accident)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        wget \
        ca-certificates \
        git \
        curl \
        maven \
        locales \
        tzdata \
        && rm -rf /var/lib/apt/lists/*

# Set JAVA_HOME for JDK 8 and update PATH
ENV JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
ENV PATH=$JAVA_HOME/bin:$PATH

# Set up UTF-8 locale for consistency
RUN locale-gen en_US.UTF-8 && update-locale LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

WORKDIR /testbed/

# Clone the repo and check out the specified commit
RUN git clone https://github.com/apache/commons-cli.git /testbed && \
    chmod -R 777 /testbed && \
    git reset --hard e91b9d87efa8946a82d58858940882f012d63d00 && \
    git remote remove origin

# Install project in Maven development mode (skip tests)
RUN mvn install -DskipTests

SHELL ["/bin/bash", "-c"]