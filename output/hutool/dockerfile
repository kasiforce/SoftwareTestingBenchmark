FROM --platform=linux/amd64 eclipse-temurin:8-jdk-jammy

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        wget \
        git \
        curl \
        maven \
        locales \
        tzdata \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN ln -fs /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    dpkg-reconfigure --frontend noninteractive tzdata && \
    locale-gen en_US.UTF-8 && \
    update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=$JAVA_HOME/bin:$PATH
ENV MAVEN_OPTS="-XX:+TieredCompilation -XX:TieredStopAtLevel=1"

WORKDIR /testbed/

RUN java -version && mvn -version

RUN git clone https://github.com/chinabugotech/hutool.git /testbed && \
    cd /testbed && \
    git reset --hard 8870454b2a0c29cc6ffd31dcf5667c8ceb2fc442 && \
    git remote remove origin

RUN mvn install \
    -DskipTests=true \
    -Dmaven.javadoc.skip=true \
    -B -V

RUN mvn dependency:resolve && \
    mvn dependency:resolve-plugins

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir openai

RUN echo "export TZ=Asia/Shanghai" >> /root/.bashrc && \
    echo "export JAVA_HOME=/opt/java/openjdk" >> /root/.bashrc && \
    echo 'export PATH=$JAVA_HOME/bin:$PATH' >> /root/.bashrc && \
    echo 'export MAVEN_OPTS="-XX:+TieredCompilation -XX:TieredStopAtLevel=1"' >> /root/.bashrc