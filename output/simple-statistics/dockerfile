# # Done -- ready for running tests via npm test (not executed here per requirements)

FROM ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive

# install system deps
RUN apt update && apt install -y curl git build-essential locales-all tzdata ca-certificates

# install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && npm install -g npm@latest

WORKDIR /testbed

# clone project
RUN git clone https://github.com/simple-statistics/simple-statistics.git /testbed && \
    cd /testbed && git reset --hard 3949249 && git remote remove origin

# install project deps + rollup + plugins
RUN npm install --save-dev rollup @rollup/plugin-node-resolve @rollup/plugin-commonjs @babel/core @babel/preset-env babel-jest @babel/plugin-transform-modules-commonjs @jest/globals

# add node_modules/.bin to PATH
ENV PATH=/testbed/node_modules/.bin:$PATH